{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "redirects": [
    { "source": "/inicio", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/xph-logo.png", "destination": "/api/xph-logo-png" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/bodas", "destination": "/bodas/index.html" },
    { "source": "/xv-anos", "destination": "/xv-anos/index.html" },
    { "source": "/bautizos", "destination": "/bautizos/index.html" },
    { "source": "/retratos", "destination": "/retratos/index.html" },
    { "source": "/empresarial", "destination": "/empresarial/index.html" },
    { "source": "/:category", "destination": "/api/category-page?slug=:category" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
