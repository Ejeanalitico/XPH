# URL del despliegue de Google Apps Script. Se usa solo desde funciones de servidor.
XPH_APPS_SCRIPT_URL="https://script.google.com/macros/s/REEMPLAZAR/exec"

# Debe coincidir con la propiedad XPH_API_SECRET del proyecto de Apps Script.
# Genera un valor aleatorio largo y nunca lo expongas como variable VITE_*.
XPH_APPS_SCRIPT_SHARED_SECRET="REEMPLAZAR_CON_SECRETO_ALEATORIO"

# Secreto independiente para firmar las sesiones administrativas.
XPH_SESSION_SECRET="REEMPLAZAR_CON_OTRO_SECRETO_ALEATORIO"

# Credenciales administrativas solo del servidor. No uses prefijo VITE_.
XPH_ADMIN_EMAIL="admin@ejemplo.com"
XPH_ADMIN_PASSWORD="REEMPLAZAR_CON_CONTRASENA_FUERTE"

# OAuth de Google para invitaciones de colaboradores y calendarios personales.
# El mismo Client ID/Secret debe configurarse también como propiedades
# XPH_GOOGLE_CLIENT_ID y XPH_GOOGLE_CLIENT_SECRET en Apps Script.
XPH_GOOGLE_CLIENT_ID="REEMPLAZAR.apps.googleusercontent.com"
XPH_GOOGLE_CLIENT_SECRET="REEMPLAZAR_CON_SECRETO_OAUTH"

# Token de solo lectura y limitado al proyecto para mostrar Web Analytics en el panel.
XPH_VERCEL_ANALYTICS_TOKEN="REEMPLAZAR_CON_TOKEN_DE_PROYECTO"
XPH_VERCEL_PROJECT_ID="prj_REEMPLAZAR"
XPH_VERCEL_TEAM_ID="team_REEMPLAZAR"
